#!/usr/bin/env bash
# Wartet auf das CI-Ergebnis eines Commits (Branch ci-results) und gibt es aus.
# Aufruf: tools/ci-wait [SHA] [MAX_SEKUNDEN]
# Exit 0 = alle Jobs success, 1 = mindestens ein Job nicht success, 3 = noch kein Ergebnis.
sha=${1:-$(git rev-parse HEAD)}
max=${2:-540}
sha=$(git rev-parse "$sha")
start=$(date +%s)
while :; do
  if git fetch -q --depth=1 origin ci-results 2>/dev/null && git show "FETCH_HEAD:results/$sha.md" > /tmp/ci-$sha.md 2>/dev/null; then
    cat /tmp/ci-$sha.md
    if tr -d "\r" < /tmp/ci-$sha.md | grep "^## " | grep -vq ': success$'; then exit 1; fi
    exit 0
  fi
  [ $(( $(date +%s) - start )) -ge "$max" ] && { echo "noch kein Ergebnis für $sha"; exit 3; }
  sleep 30
done
