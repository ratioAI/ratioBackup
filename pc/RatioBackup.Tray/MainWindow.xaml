<Window x:Class="RatioBackup.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RatioBackup.Tray"
        Title="RatioBackup" Width="1180" Height="760" MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Fg}">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Seitenleiste -->
    <DockPanel Background="{DynamicResource Side}">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,12,18">
        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}">
          <TextBlock Text="R" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="RatioBackup" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <Border DockPanel.Dock="Bottom" Margin="12" Padding="14" CornerRadius="10" Background="{DynamicResource Card}">
        <StackPanel>
          <TextBlock Text="Gekoppelt" Style="{StaticResource Label}" />
          <TextBlock x:Name="SideDevice" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,2" />
          <TextBlock x:Name="SideVerify" Style="{StaticResource Label}" />
        </StackPanel>
      </Border>
      <StackPanel Margin="12,0,12,0">
        <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" Width="28" VerticalAlignment="Center" /><TextBlock Text="Übersicht" /></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavTrash" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" Width="28" VerticalAlignment="Center" /><TextBlock Text="Papierkorb" /><Border x:Name="TrashBadge" Background="{DynamicResource Warn}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" Visibility="Collapsed"><TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" /></Border></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavHistory" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" Width="28" VerticalAlignment="Center" /><TextBlock Text="Verlauf" /></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="nav" Checked="Nav_Checked">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" Width="28" VerticalAlignment="Center" /><TextBlock Text="Einstellungen" /></StackPanel>
        </RadioButton>
      </StackPanel>
    </DockPanel>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,24,28,28">

        <!-- Übersicht -->
        <StackPanel x:Name="PageOverview">
          <DockPanel Margin="0,0,0,16">
            <Border x:Name="UpdateBanner" DockPanel.Dock="Right" Background="{DynamicResource Pill}" CornerRadius="10" Padding="14,8" VerticalAlignment="Bottom" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="UpdateText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="UpdateButton" Content="Jetzt aktualisieren" Style="{StaticResource Primary}" Click="Update_Click" />
              </StackPanel>
            </Border>
            <StackPanel>
              <TextBlock x:Name="TodayText" Style="{StaticResource Label}" FontSize="13" />
              <TextBlock Text="Übersicht" Style="{StaticResource H1}" />
            </StackPanel>
          </DockPanel>

          <Border x:Name="ErrorBanner" Background="{DynamicResource WarnBg}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" FontSize="13" />
          </Border>

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Grid Width="168" Height="168" DockPanel.Dock="Left" Margin="0,0,28,0">
                  <local:Ring x:Name="RunRing" Thickness="14" Track="{DynamicResource Line}" Fill="{DynamicResource Accent}" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="RunPercent" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="RunSub" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="RunKicker" Style="{StaticResource Kicker}" Margin="0,0,0,12" />
                  <UniformGrid x:Name="RunStats" Columns="3">
                    <StackPanel><TextBlock x:Name="StatFiles" FontSize="20" FontWeight="Bold" /><TextBlock Text="Dateien" Style="{StaticResource Label}" /></StackPanel>
                    <StackPanel><TextBlock x:Name="StatBytes" FontSize="20" FontWeight="Bold" /><TextBlock Text="empfangen" Style="{StaticResource Label}" /></StackPanel>
                    <StackPanel><TextBlock x:Name="StatSpeed" FontSize="20" FontWeight="Bold" /><TextBlock Text="Tempo" Style="{StaticResource Label}" /></StackPanel>
                  </UniformGrid>
                  <TextBlock x:Name="IdleText" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" />
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Speicher" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                  <local:Ring x:Name="StorageRing" Width="96" Height="96" Thickness="12" Track="{DynamicResource Line}" Fill="{DynamicResource Accent}" Fill2="{DynamicResource Warn}" />
                  <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StorageUsed" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="StorageQuota" Style="{StaticResource Label}" FontSize="13" />
                    <TextBlock x:Name="StorageTrash" Style="{StaticResource Label}" FontSize="13" />
                    <TextBlock x:Name="StorageDisk" Style="{StaticResource Label}" FontSize="13" />
                  </StackPanel>
                </StackPanel>
                <Button Content="Ordner öffnen" Style="{StaticResource Secondary}" Margin="0,14,0,0" Click="OpenFolder_Click" />
              </StackPanel>
            </Border>
          </Grid>

          <UniformGrid Columns="3" Margin="-8,0,-8,16">
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="22,16"><StackPanel><TextBlock Text="Letzte erfolgreiche Sicherung" Style="{StaticResource Label}" /><TextBlock x:Name="CardLast" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="22,16"><StackPanel><TextBlock Text="Gesichert" Style="{StaticResource Label}" /><TextBlock x:Name="CardMirror" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="8,0" Padding="22,16"><StackPanel><TextBlock Text="Zeitplan" Style="{StaticResource Label}" /><TextBlock Text="Am Handy einstellbar" FontSize="18" FontWeight="Bold" /></StackPanel></Border>
          </UniformGrid>

          <Border Style="{StaticResource Card}" Padding="22,16">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Alle anzeigen" Style="{StaticResource Secondary}" Height="28" Click="ShowHistory_Click" />
                <TextBlock Text="Letzte Läufe" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel x:Name="RecentRuns" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Papierkorb -->
        <StackPanel x:Name="PageTrash" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,16">
            <TextBox x:Name="TrashSearch" DockPanel.Dock="Right" Width="260" VerticalAlignment="Bottom" TextChanged="TrashSearch_Changed" ToolTip="Dateien suchen" />
            <StackPanel>
              <TextBlock Text="Am Handy gelöscht · 30 Tage wiederherstellbar" Style="{StaticResource Label}" FontSize="13" />
              <TextBlock Text="Papierkorb" Style="{StaticResource H1}" />
            </StackPanel>
          </DockPanel>
          <Border x:Name="ReviewBanner" Background="{DynamicResource WarnBg}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Behalten" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="KeepHeld_Click" />
                <Button Content="In Papierkorb verschieben" Style="{StaticResource Primary}" Click="TrashHeld_Click" />
              </StackPanel>
              <TextBlock x:Name="ReviewText" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="20,10,20,14">
            <StackPanel>
              <DockPanel Margin="0,4,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="RestoreSelected" Content="Auswahl wiederherstellen" Style="{StaticResource Primary}" Margin="0,0,8,0" Click="RestoreSelected_Click" />
                  <Button x:Name="DeleteSelected" Content="Endgültig löschen" Style="{StaticResource Danger}" Click="DeleteSelected_Click" />
                </StackPanel>
                <TextBlock x:Name="TrashSummary" Style="{StaticResource Label}" FontSize="13" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel x:Name="TrashList" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Verlauf -->
        <StackPanel x:Name="PageHistory" Visibility="Collapsed">
          <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Letzte 100 Läufe" Style="{StaticResource Label}" FontSize="13" />
            <TextBlock Text="Verlauf" Style="{StaticResource H1}" />
          </StackPanel>
          <Border Style="{StaticResource Card}" Padding="22,10">
            <StackPanel x:Name="HistoryList" />
          </Border>
        </StackPanel>

        <!-- Einstellungen -->
        <StackPanel x:Name="PageSettings" Visibility="Collapsed" MaxWidth="760" HorizontalAlignment="Left">
          <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="SettingsVersion" Style="{StaticResource Label}" FontSize="13" />
            <TextBlock Text="Einstellungen" Style="{StaticResource H1}" />
          </StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Ablageordner" FontSize="14" FontWeight="SemiBold" />
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Öffnen" Style="{StaticResource Secondary}" Click="OpenFolder_Click" />
                <TextBlock x:Name="SetFolder" Style="{StaticResource Body}" VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Speicherlimit" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="Ist es erreicht, wird erst der Papierkorb geleert, dann pausiert die Sicherung." Style="{StaticResource Label}" Margin="0,4,0,8" />
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SetQuota" Width="90" />
                <TextBlock Text="GB" VerticalAlignment="Center" Margin="8,0,12,0" />
                <Button Content="Speichern" Style="{StaticResource Primary}" Click="SaveQuota_Click" />
                <TextBlock x:Name="QuotaSaved" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <CheckBox x:Name="SetAutostart" Content="Mit Windows starten (im Hintergrund)" Click="Autostart_Click" FontSize="14" />
              <TextBlock Text="Empfohlen: Nur so kann das Handy abends sichern, ohne dass du das Programm öffnest." Style="{StaticResource Label}" Margin="22,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Handy neu koppeln" Style="{StaticResource Secondary}" VerticalAlignment="Center" Click="Pair_Click" />
              <StackPanel>
                <TextBlock Text="Handy" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="SetDevice" Style="{StaticResource Label}" FontSize="13" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button x:Name="CheckUpdateButton" DockPanel.Dock="Right" Content="Nach Updates suchen" Style="{StaticResource Secondary}" VerticalAlignment="Center" Click="CheckUpdate_Click" />
              <StackPanel>
                <TextBlock Text="Updates" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="SetUpdate" Style="{StaticResource Label}" FontSize="13" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
