<Window x:Class="RatioBackup.Tray.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handy koppeln" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}">
  <StackPanel Margin="28">
    <TextBlock Text="Handy koppeln" Style="{StaticResource H1}" FontSize="24" />
    <TextBlock Text="Öffne RatioBackup auf dem Handy → „PC suchen“ und gib diesen Code ein:" Style="{StaticResource Body}" Foreground="{DynamicResource Muted}" Margin="0,6,0,14" />
    <Border Style="{StaticResource Card}" HorizontalAlignment="Stretch">
      <StackPanel HorizontalAlignment="Center">
        <TextBlock x:Name="CodeText" FontSize="48" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center" FontFamily="Consolas" />
        <TextBlock x:Name="VerifyText" Style="{StaticResource Label}" HorizontalAlignment="Center" FontSize="13" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <TextBlock Text="Das Handy zeigt denselben Prüfcode. Stimmt er nicht überein, nicht koppeln. Der Code gilt 5 Minuten; Handy und PC müssen im selben WLAN sein." Style="{StaticResource Label}" Margin="0,12,0,0" />
    <TextBlock Text="Fragt Windows nach der Firewall: bitte für private Netzwerke zulassen." Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Neuer Code" Style="{StaticResource Secondary}" Click="Renew_Click" Margin="0,0,8,0" />
      <Button Content="Schließen" Style="{StaticResource Secondary}" IsCancel="True" Click="Close_Click" />
    </StackPanel>
  </StackPanel>
</Window>
